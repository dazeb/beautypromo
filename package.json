{
  "name": "lumiere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "db:seed": "node server/seed.ts",
    "db:retailers": "node server/seed.ts --retailers-only",
    "typecheck": "tsc --noEmit",
    "check:affiliates": "node --test scripts/check-affiliates.ts",
    "check:seo": "pnpm build && node --test scripts/check-seo.ts",
    "check:amp": "pnpm build && node --test scripts/check-amp.ts",
    "deploy": "scripts/deploy.sh",
    "go-live": "scripts/go-live-domain.sh"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
